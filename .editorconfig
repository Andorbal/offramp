root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Verify snapshots are compared byte-for-byte.
[*.{received,verified}.*]
charset = utf-8-bom
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = false

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = when_multiline:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: private fields are _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_const_pascal.symbols = private_const
dotnet_naming_rule.private_const_pascal.style = pascal
dotnet_naming_rule.private_const_pascal.severity = warning
dotnet_naming_symbols.private_const.applicable_kinds = field
dotnet_naming_symbols.private_const.applicable_accessibilities = private
dotnet_naming_symbols.private_const.required_modifiers = const

# Style rules that are useful as suggestions but noisy as build errors.
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using
dotnet_diagnostic.IDE0008.severity = none      # explicit type
dotnet_diagnostic.IDE0011.severity = none      # braces
dotnet_diagnostic.IDE0022.severity = none      # expression body
dotnet_diagnostic.IDE0046.severity = none      # conditional expression for return
dotnet_diagnostic.IDE0045.severity = none      # conditional expression for assignment
dotnet_diagnostic.IDE0058.severity = none      # expression value never used
dotnet_diagnostic.IDE0010.severity = none      # populate switch
dotnet_diagnostic.IDE0072.severity = none      # populate switch expression
dotnet_diagnostic.IDE0130.severity = none      # namespace matches folder
dotnet_diagnostic.IDE0290.severity = none      # primary constructors
dotnet_diagnostic.IDE0305.severity = none      # collection expression for fluent
dotnet_diagnostic.IDE0055.severity = none      # formatting (not enforced in build)

# Analyzer rules tuned for a CLI tool
dotnet_diagnostic.CA1303.severity = none       # localized literals: English-only CLI
dotnet_diagnostic.CA1716.severity = none       # identifiers conflicting with keywords (e.g. Shared)
dotnet_diagnostic.CA1724.severity = none       # type names conflicting with namespaces
dotnet_diagnostic.CA1812.severity = none       # instantiated via DI / reflection-free registries
dotnet_diagnostic.CA1848.severity = none       # LoggerMessage delegates: no ILogger usage
dotnet_diagnostic.CA2007.severity = none       # ConfigureAwait: console app, no sync context
dotnet_diagnostic.CA1062.severity = none       # null checks on public args: nullable enabled
dotnet_diagnostic.CA1031.severity = none       # catching general exceptions at boundaries is deliberate
dotnet_diagnostic.CA1515.severity = none       # public types in exe are fine
dotnet_diagnostic.CA1002.severity = none       # List<T> in public API
dotnet_diagnostic.CA1819.severity = none       # arrays as properties in records
dotnet_diagnostic.CA2227.severity = none       # settable collections (config binding)
dotnet_diagnostic.CA1056.severity = none       # URI properties as string
dotnet_diagnostic.CA1054.severity = none       # URI parameters as string
dotnet_diagnostic.CA1055.severity = none       # URI return values as string
dotnet_diagnostic.CA1308.severity = none       # ToLowerInvariant is intended for identifiers
dotnet_diagnostic.CA1720.severity = none       # identifiers like Pointer/Guid describe JSON fields
dotnet_diagnostic.CA1000.severity = none       # static factories on generic result types read well
dotnet_diagnostic.CA1826.severity = none       # FirstOrDefault on lists reads better than index checks

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none       # underscores in test names
dotnet_diagnostic.CA1861.severity = none       # constant arrays as arguments
dotnet_diagnostic.CA2000.severity = none       # dispose in tests
dotnet_diagnostic.CA1063.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.xUnit1051.severity = none    # TestContext cancellation token everywhere is noise
