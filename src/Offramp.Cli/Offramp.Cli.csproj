<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The `offramp` .NET global tool: parsing and rendering only. All logic lives
    in the library projects.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RollForward>LatestMajor</RollForward>
    <RootNamespace>Offramp.Cli</RootNamespace>
    <AssemblyName>offramp</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>offramp</ToolCommandName>
    <PackageId>offramp</PackageId>
    <Title>Offramp</Title>
    <Description>The off-ramp from .NET Framework: deterministic analysis, pure file moves, dependency consolidation, and scaffolding for incremental migrations of large .NET Framework codebases to modern .NET.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offramp.Core\Offramp.Core.csproj" />
    <ProjectReference Include="..\Offramp.Workspace\Offramp.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offramp.Cli.Tests" />
  </ItemGroup>
</Project>
