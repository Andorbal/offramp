<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Workspace ingest (binlog/complog, assets files, project graph) and the
    environment and repository checks behind `doctor`.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offramp.Workspace</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offramp.Core\Offramp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.ProjectModel" />
    <PackageReference Include="MSBuild.StructuredLogger" />
    <PackageReference Include="Basic.CompilerLog.Util" />
    <!-- The meta-package lifts every Roslyn assembly Basic.CompilerLog pulls in to one version. -->
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

  <ItemGroup>
    <!-- What doctor fix writes into a repository with packages.config projects (ADR 0064). -->
    <EmbeddedResource Include="Doctor\Resources\Offramp.PackagesConfig.targets" LogicalName="Offramp.Workspace.Doctor.Offramp.PackagesConfig.targets" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offramp.Workspace.Tests" />
  </ItemGroup>
</Project>
