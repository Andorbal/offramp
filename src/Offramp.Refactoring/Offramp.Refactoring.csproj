<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Commands that write to the user's repository: change sets (renames, project
    file edits, new files) with a dry-run diff, a journal, and rollback; project
    file editing with Microsoft.Build's construction model (no evaluation); and
    the movers built on them.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offramp.Refactoring</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offramp.Core\Offramp.Core.csproj" />
    <ProjectReference Include="..\Offramp.Workspace\Offramp.Workspace.csproj" />
    <ProjectReference Include="..\Offramp.Analysis\Offramp.Analysis.csproj" />
    <ProjectReference Include="..\Offramp.NuGet\Offramp.NuGet.csproj" />
    <!-- The codemods (docs/spec/commands/codemod.md): netstandard2.0 analyzers and fixers that `codemod run` drives. -->
    <ProjectReference Include="..\Offramp.Analyzers\Offramp.Analyzers.csproj" />
    <ProjectReference Include="..\Offramp.Analyzers.CodeFixes\Offramp.Analyzers.CodeFixes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Construction API only (ProjectRootElement); nothing is evaluated, so no MSBuildLocator. -->
    <PackageReference Include="Microsoft.Build" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\test-projects.yml" LogicalName="Offramp.Refactoring.Rules.test-projects.yml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offramp.Refactoring.Tests" />
  </ItemGroup>
</Project>
