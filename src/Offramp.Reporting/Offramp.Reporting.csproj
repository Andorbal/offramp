<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Views for people and machines over the workspace model: graph exporters
    (json, dot, mermaid, html), the progress report, and audit documents
    (SARIF, Markdown).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offramp.Reporting</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offramp.Analysis\Offramp.Analysis.csproj" />
    <ProjectReference Include="..\Offramp.Core\Offramp.Core.csproj" />
    <ProjectReference Include="..\Offramp.Workspace\Offramp.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*" LogicalName="Offramp.Reporting.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offramp.Reporting.Tests" />
  </ItemGroup>
</Project>
