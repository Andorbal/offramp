    /// <summary>
    /// Runs a characterization probe, writes what it observed where Offramp asks
    /// (OFFRAMP_NEWTONSOFT_RESULTS), and outside recording compares it with the baseline next to
    /// this file, so the probe also fails in any test runner when the behavior changes.
    /// </summary>
    internal static class OfframpProbe
    {
        public const string Format = "# offramp-newtonsoft-probe 1";

        public static void Check(string probe, Func<object> observe, [CallerFilePath] string source = "")
        {
            var record = Observe(probe, observe);
            var runtime = Runtime();
            var results = Environment.GetEnvironmentVariable("OFFRAMP_NEWTONSOFT_RESULTS");
            if (!string.IsNullOrEmpty(results))
            {
                var folder = Path.Combine(results, runtime);
                Directory.CreateDirectory(folder);
                File.WriteAllText(Path.Combine(folder, probe + ".txt"), record, new UTF8Encoding(false));
            }

            if (Environment.GetEnvironmentVariable("OFFRAMP_NEWTONSOFT_MODE") == "record")
            {
                return;
            }

            var baseline = Path.Combine(Folder(source), "Baseline", runtime, probe + ".txt");
            if (!File.Exists(baseline))
            {
                throw new OfframpProbeMismatchException(probe + " has no baseline at " + baseline + "; record one with `offramp newtonsoft tests --record --apply`.");
            }

            var expected = Observation(Normalize(File.ReadAllText(baseline)));
            var actual = Observation(record);
            if (expected != actual)
            {
                throw new OfframpProbeMismatchException(probe + " differs from its baseline.\n--- baseline\n" + expected + "\n--- now\n" + actual);
            }
        }

        /// <summary>
        /// The JSON a reading probe is given: "Inputs/&lt;file&gt;" (a real payload next to this file), or
        /// "probe:&lt;id&gt;" (what that probe wrote: this run's result while recording, its baseline otherwise).
        /// </summary>
        public static string Input(string name, [CallerFilePath] string source = "")
        {
            if (!name.StartsWith("probe:", StringComparison.Ordinal))
            {
                return Normalize(File.ReadAllText(Path.Combine(Folder(source), name)));
            }

            var probe = name.Substring("probe:".Length);
            var results = Environment.GetEnvironmentVariable("OFFRAMP_NEWTONSOFT_RESULTS");
            var path = Environment.GetEnvironmentVariable("OFFRAMP_NEWTONSOFT_MODE") == "record" && !string.IsNullOrEmpty(results)
                ? Path.Combine(results, Runtime(), probe + ".txt")
                : Path.Combine(Folder(source), "Baseline", Runtime(), probe + ".txt");
            var record = Normalize(File.ReadAllText(path));
            if (record.IndexOf("\noutcome: returned\n", StringComparison.Ordinal) < 0)
            {
                throw new InvalidOperationException(probe + " threw, so it wrote no JSON to read.");
            }

            return record.Substring(record.IndexOf("\n---\n", StringComparison.Ordinal) + "\n---\n".Length).TrimEnd('\n');
        }

        private static string Observe(string probe, Func<object> observe)
        {
            var thread = Thread.CurrentThread;
            var culture = thread.CurrentCulture;
            var uiCulture = thread.CurrentUICulture;
            string outcome;
            string body;
            try
            {
                thread.CurrentCulture = System.Globalization.CultureInfo.InvariantCulture;
                thread.CurrentUICulture = System.Globalization.CultureInfo.InvariantCulture;
                body = OfframpObjectDump.Write(observe());
                outcome = "returned";
            }
            catch (Exception thrown)
            {
                var e = thrown;
                while ((e is TargetInvocationException || e is AggregateException || e is TypeInitializationException) && e.InnerException != null)
                {
                    e = e.InnerException;
                }

                outcome = "threw";
                body = e.GetType().FullName + "\n\n" + Normalize(e.Message);
            }
            finally
            {
                thread.CurrentCulture = culture;
                thread.CurrentUICulture = uiCulture;
            }

            return Format + "\nprobe: " + probe + "\nnewtonsoft: " + NewtonsoftVersion() + "\noutcome: " + outcome + "\n---\n" + body + "\n";
        }

        /// <summary>What is compared: the outcome and the body, not the header that names the release.</summary>
        private static string Observation(string record)
        {
            var at = record.IndexOf("\noutcome: ", StringComparison.Ordinal);
            return at < 0 ? record : record.Substring(at + 1).TrimEnd('\n');
        }

        private static string Folder(string source)
        {
            var folder = Environment.GetEnvironmentVariable("OFFRAMP_NEWTONSOFT_DIR");
            return string.IsNullOrEmpty(folder) ? Path.GetDirectoryName(source) : folder;
        }

        private static string Runtime()
        {
            return typeof(object).Assembly.GetName().Name == "mscorlib" ? "netfx" : "core";
        }

        private static string NewtonsoftVersion()
        {
            foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
            {
                var name = assembly.GetName();
                if (name.Name == "Newtonsoft.Json")
                {
                    return name.Version.ToString();
                }
            }

            return "none";
        }

        internal static string Normalize(string text)
        {
            return text.Replace("\r\n", "\n");
        }
    }

    /// <summary>A probe's observation differs from its baseline.</summary>
    internal sealed class OfframpProbeMismatchException : Exception
    {
        public OfframpProbeMismatchException(string message)
            : base(message)
        {
        }
    }
}
