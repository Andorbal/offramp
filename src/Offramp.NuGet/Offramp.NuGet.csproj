<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Package intelligence: feed access through the NuGet client libraries (the
    repository's nuget.config), nupkg inspection, target-framework support,
    Windows-only detection, and the package and framework-assembly mapping tables.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offramp.NuGet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offramp.Core\Offramp.Core.csproj" />
    <ProjectReference Include="..\Offramp.Workspace\Offramp.Workspace.csproj" />
    <ProjectReference Include="..\Offramp.Analysis\Offramp.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Frameworks" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\package-map.yml" LogicalName="Offramp.NuGet.Rules.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offramp.NuGet.Tests" />
  </ItemGroup>
</Project>
