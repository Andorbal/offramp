<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Model records, offramp.yml binding and validation, diagnostics, progress,
    the output envelope, caching, git, and process helpers.
    References nothing else in src/ (see CLAUDE.md, layering).
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Offramp.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- JsonSerializerOptions.NewLine and friends: same output bytes on every runtime. -->
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\v1\config.json" LogicalName="Offramp.Schemas.v1.config.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Offramp.Core.Tests" />
  </ItemGroup>
</Project>
