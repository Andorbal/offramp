<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="ShopName" value="Contoso Shop" />
  </appSettings>
  <connectionStrings>
    <add name="Shop" connectionString="Server=(local);Database=Shop;Integrated Security=true" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="2880" />
    </authentication>
    <sessionState mode="InProc" timeout="20" />
    <machineKey validationKey="AutoGenerate,IsolateApps" decryptionKey="AutoGenerate,IsolateApps" validation="HMACSHA256" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error" />
    <httpModules>
      <add name="RequestTiming" type="Shop.Web.Modules.RequestTimingModule, Shop.Web" />
    </httpModules>
  </system.web>
  <system.webServer>
    <modules>
      <add name="RequestTiming" type="Shop.Web.Modules.RequestTimingModule, Shop.Web" />
    </modules>
    <handlers>
      <add name="Thumbnail" path="thumbnail.axd" verb="GET" type="Shop.Web.Handlers.ThumbnailHandler, Shop.Web" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
