<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    NuGet 2's package restore, which Visual Studio's "Enable NuGet Package Restore" added to a
    solution. The real file runs NuGet.exe before each build; this one stands in for it.
  -->
  <PropertyGroup>
    <RestorePackages Condition="'$(RestorePackages)' == ''">false</RestorePackages>
  </PropertyGroup>
</Project>
