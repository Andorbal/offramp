<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="InvoicePrefix" value="PRD" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="Region" value="eu-west" xdt:Transform="Insert" />
    <add key="PageSize" xdt:Transform="Remove" xdt:Locator="Match(key)" />
  </appSettings>
  <connectionStrings>
    <add name="Billing" connectionString="Server=sql.prod;Database=Billing;Integrated Security=true" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <billing currency="USD" retries="5" xdt:Transform="SetAttributes" />
</configuration>
