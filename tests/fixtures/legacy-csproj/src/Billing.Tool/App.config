<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="billing" type="Contoso.Billing.BillingSection, Billing" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="InvoicePrefix" value="INV" />
    <add key="PageSize" value="50" />
    <add key="Features:Audit" value="true" />
  </appSettings>
  <connectionStrings>
    <add name="Billing" connectionString="Server=(local);Database=Billing;Integrated Security=true" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <billing currency="EUR" retries="3" timeout="00:00:30">
    <audit enabled="true" path="C:\Audit" />
  </billing>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
