<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Contoso.Catalog</RootNamespace>
    <!-- 7.0.1 has a known advisory (NU1903) and only .NET Framework assets (NU1701): both are the point. -->
    <NoWarn>$(NoWarn);NU1701;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="7.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Catalog.Tests" />
  </ItemGroup>
</Project>
