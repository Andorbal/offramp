<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Hand-written packages for test cases (generated from feed.json; see README.md). -->
    <add key="synthetic" value="synthetic-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="synthetic">
      <package pattern="Contoso.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
