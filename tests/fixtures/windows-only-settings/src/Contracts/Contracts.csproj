<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- sgen loads the built assembly under the .NET Framework runtime; .NET's MSBuild has no SGen task (MSB3474). -->
    <GenerateSerializationAssemblies>On</GenerateSerializationAssemblies>
  </PropertyGroup>
  <!-- A copy written for cmd.exe, in the target Visual Studio adds for an SDK-style project's post-build event. -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /y &quot;$(TargetPath)&quot; &quot;$(MSBuildProjectDirectory)\..\..\drop\&quot;" />
  </Target>
</Project>
