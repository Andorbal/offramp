<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Test projects: one per src project, xunit v3 + Verify, net10.0 only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>$(MSBuildProjectName.EndsWith('.Tests'))</IsTestProject>
    <OutputType Condition="'$(IsTestProject)' == 'true'">Exe</OutputType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- IDE0005 needs documentation generation; tests do without. -->
    <NoWarn>$(NoWarn);EnableGenerateDocumentationFile;IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="coverlet.collector" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
