              "id": "OFR3201",
              "name": "InsecureSerializer",
              "shortDescription": {
                "text": "insecure serializer"
              },
              "helpUri": "https://offramp.dev/diagnostics/OFR3201",
              "help": {
                "text": "BinaryFormatter and its relatives are removed (throw) from .NET 9; migrate the data, using the System.Runtime.Serialization.Formatters compatibility package only while a dual-read migration runs."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "serialization",
                "tags": [
                  "offramp",
                  "serialization",
                  "serialization"
                ]
              }
            },
            {
              "id": "OFR3202",
              "name": "TransientBinarySerializationDeepClone",
              "shortDescription": {
                "text": "transient binary serialization (deep clone)"
              },
              "helpUri": "https://offramp.dev/diagnostics/OFR3202",
              "help": {
                "text": "The data never leaves the process; replace the round trip with a copy constructor, a record \u0060with\u0060, or a System.Text.Json round trip (\u0060offramp codemod\u0060)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "serialization",
                "tags": [
                  "offramp",
                  "serialization",
                  "serialization"
                ]
              }
            },
            {
              "id": "OFR3203",
              "name": "PersistedOrTransportedBinarySerialization",
              "shortDescription": {
                "text": "persisted or transported binary serialization"
              },
              "helpUri": "https://offramp.dev/diagnostics/OFR3203",
              "help": {
                "text": "Data written with BinaryFormatter outlives the process; plan a dual-read migration to a safe format before the target drops the formatter."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "serialization",
                "tags": [
                  "offramp",
                  "serialization",
                  "serialization"
                ]
              }
            },
            {
              "id": "OFR3204",
              "name": "TypeSerializedWithABinaryFormatter",
              "shortDescription": {
                "text": "type serialized with a binary formatter"
              },
              "helpUri": "https://offramp.dev/diagnostics/OFR3204",
              "help": {
                "text": "Each listed type needs a new serialized shape; ISerializable, OnDeserialized hooks, and delegate members need attention."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
