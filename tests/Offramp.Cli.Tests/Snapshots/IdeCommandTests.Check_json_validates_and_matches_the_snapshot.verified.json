{
  "$schema": "https://offramp.dev/schemas/v1/envelope.json",
  "offramp": {
    "version": "{Version}",
    "command": "ide check",
    "target": "net10.0",
    "repositoryRoot": "{RepositoryRoot}",
    "solution": "IdeCounterpart.slnx",
    "workspaceHash": "sha256:{Hash}",
    "startedAt": "{StartedAt}",
    "durationMs": 0,
    "effectiveConfig": {
      "deadCode": {
        "externalConsumers": []
      },
      "deps": {
        "cpm": {
          "file": "Directory.Packages.props",
          "scope": "solution"
        },
        "families": [],
        "feeds": null,
        "ignore": [],
        "includePrerelease": false,
        "packageMap": [],
        "pins": [],
        "preferNewest": false,
        "redirects": {
          "manage": []
        }
      },
      "ide": {
        "implicitCounterparts": true,
        "newCode": {
          "base": "auto",
          "scope": "lines"
        }
      },
      "llm": {
        "apiKeyEnv": "OFFRAMP_LLM_API_KEY",
        "enabled": false,
        "model": null,
        "provider": "openai",
        "url": "http://localhost:1234/v1",
        "uses": [
          "naming",
          "ranking"
        ]
      },
      "move": {
        "coMove": "closure",
        "namespaceMismatch": "allow",
        "suppressAnalyzers": [
          "IDE0130"
        ],
        "tests": {
          "frameworks": [
            "xunit",
            "nunit",
            "mstest",
            "tunit"
          ],
          "helperMinConfidence": "high",
          "stripTestsSegment": true,
          "targetSuffix": ".Tests"
        },
        "verify": "end"
      },
      "paths": {
        "exclude": [],
        "state": ".offramp"
      },
      "projectMap": [],
      "projects": [],
      "report": {
        "ledger": ".offramp/ledger",
        "title": null
      },
      "rules": {
        "packs": {
          "disable": []
        }
      },
      "seams": {
        "hostFramework": "auto",
        "unportableSources": [
          "audit"
        ],
        "unportableSymbols": []
      },
      "service": {
        "dockerfile": true,
        "healthEndpoint": true,
        "host": "linux",
        "k8s": false,
        "logging": "json-console"
      },
      "solution": null,
      "target": 10,
      "verify": {
        "command": null,
        "configuration": "Debug",
        "mode": "build",
        "noWarn": [],
        "onFailure": "rollback",
        "projects": {
          "exclude": [],
          "include": []
        },
        "properties": {},
        "restore": true,
        "timeoutSeconds": 1800,
        "warnAsError": []
      },
      "version": 1
    }
  },
  "result": {
    "base": {
      "ref": "HEAD",
      "commit": "{Commit}",
      "scope": "lines"
    },
    "enablement": {
      "mode": "auto",
      "enabled": true,
      "reason": "state-directory"
    },
    "counterparts": [
      {
        "project": "src/Foo/Foo.csproj",
        "counterparts": [
          "src/ModernF/ModernF.csproj",
          "src/Shared/Shared.csproj"
        ],
