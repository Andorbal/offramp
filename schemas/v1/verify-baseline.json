{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/verify-baseline.json",
  "title": "Offramp verification baseline",
  "description": "`.offramp/verify/baseline.json`, written by `verify --baseline`: the accepted errors, compared without line numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "errors"],
  "properties": {
    "$schema": { "const": "https://offramp.dev/schemas/v1/verify-baseline.json" },
    "version": { "const": 1 },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "project", "file", "message"],
        "properties": {
          "code": { "type": "string" },
          "project": { "type": ["string", "null"] },
          "file": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
