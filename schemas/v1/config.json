{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/config.json",
  "title": "offramp.yml",
  "description": "Offramp configuration. See docs/spec/03-configuration.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1, "description": "Configuration format version." },
    "target": {
      "type": ["integer", "string"],
      "minimum": 5,
      "pattern": "^(net([5-9]|[1-9][0-9]{1,2})\\.0(-windows)?|netstandard2\\.[01])$",
      "description": "The modern target: a .NET major version (10 = net10.0), a .NET target framework (net8.0, net10.0-windows), or .NET Standard for libraries (netstandard2.0, netstandard2.1). See docs/decisions/0057-a-target-is-a-framework.md."
    },
    "solution": { "type": ["string", "null"], "description": "Repository-relative .sln, .slnx, or .slnf." },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": { "$ref": "#/$defs/stringList" },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["test", "web", "winforms", "wpf", "service", "console", "library", "unknown", null] },
          "frozen": { "type": "boolean" }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builder": { "enum": ["dotnet", "msbuild"], "description": "dotnet runs `dotnet build`; msbuild runs MSBuild.exe from Visual Studio or Build Tools." },
        "msbuildPath": { "type": ["string", "null"], "minLength": 1, "description": "MSBuild.exe, a folder holding it, or a Visual Studio or Build Tools installation folder. Null: the Developer Command Prompt's installation, else the newest vswhere reports." }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["build", "command", "none"] },
        "command": { "type": ["string", "null"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "noWarn": { "$ref": "#/$defs/stringList" },
        "warnAsError": { "$ref": "#/$defs/stringList" },
        "projects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "$ref": "#/$defs/stringList" },
            "exclude": { "$ref": "#/$defs/stringList" }
          }
        },
        "restore": { "type": "boolean" },
        "onFailure": { "enum": ["rollback", "keep"] }
      }
    },
    "deps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feeds": { "type": ["array", "null"], "items": { "type": "string" } },
        "includePrerelease": { "type": "boolean" },
        "preferNewest": { "type": "boolean" },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prefix"],
            "properties": {
              "prefix": { "type": "string", "minLength": 1 },
              "family": { "type": ["string", "null"] }
            }
          }
        },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "version"],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "project": { "type": ["string", "null"] },
              "version": { "type": ["string", "number"] },
              "reason": { "type": ["string", "null"] }
            }
          }
        },
        "ignore": { "$ref": "#/$defs/stringList" },
        "packageMap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["replacement"],
            "oneOf": [ { "required": ["package"] }, { "required": ["prefix"] } ],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "prefix": { "type": "string", "minLength": 1 },
              "replacement": { "type": "string", "minLength": 1 }
            }
          }
        },
        "assemblyPackages": {
          "type": "array",
          "description": "Packages that ship an assembly under another name, searched by deps resolve-dlls before rules/assembly-packages.yml.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assembly", "package"],
            "properties": {
              "assembly": { "type": "string", "minLength": 1 },
              "package": { "type": "string", "minLength": 1 }
            }
          }
        },
        "cpm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "scope": { "enum": ["solution", "repo"] }
          }
        },
        "redirects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manage": { "$ref": "#/$defs/stringList" }
          }
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": { "type": "string", "pattern": "^(none|per-project|end|batch:[1-9][0-9]*)$" },
        "namespaceMismatch": { "enum": ["allow", "warn", "block"] },
        "coMove": { "enum": ["closure", "none"] },
        "suppressAnalyzers": { "$ref": "#/$defs/stringList" },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frameworks": { "type": "array", "items": { "enum": ["xunit", "nunit", "mstest", "tunit"] } },
            "helperMinConfidence": { "enum": ["high", "medium", "low"] },
            "stripTestsSegment": { "type": "boolean" },
            "targetSuffix": { "type": "string" }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "packs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "disable": { "type": "array", "items": { "enum": ["core", "web", "desktop", "data", "serialization", "native"] } }
          }
        }
      },
      "patternProperties": {
        "^OFR[0-9]{4}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["severity"],
          "properties": {
            "severity": { "enum": ["none", "info", "warning", "error"] },
            "reason": { "type": ["string", "null"] }
          }
        }
      },
      "additionalProperties": false
    },
    "seams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unportableSources": { "type": "array", "items": { "enum": ["audit", "list"] } },
        "unportableSymbols": { "$ref": "#/$defs/stringList" },
        "hostFramework": { "enum": ["auto", "net10-windows", "net48"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "enum": ["linux", "windows", "both"] },
        "dockerfile": { "type": "boolean" },
        "k8s": { "type": "boolean" },
        "healthEndpoint": { "type": "boolean" },
        "logging": { "enum": ["json-console", "simple"] }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["openai", "anthropic"] },
        "url": { "type": "string" },
        "model": { "type": ["string", "null"] },
        "apiKeyEnv": { "type": "string" },
        "uses": { "type": "array", "items": { "enum": ["naming", "ranking", "summarizing", "classifying"] } }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": ["string", "null"] },
        "ledger": { "type": "string", "minLength": 1 }
      }
    },
    "deadCode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalConsumers": { "$ref": "#/$defs/stringList" }
      }
    },
    "projectMap": {
      "type": "array",
      "description": "Where a .NET Framework project's portable code lives. See docs/spec/commands/ide.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1, "description": "A project path or name; * and ? match any characters." },
          "to": { "type": "string", "minLength": 1, "description": "A project path or name; {name} is the matched project's name." }
        }
      }
    },
    "ide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "newCode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base": { "type": "string", "minLength": 1, "description": "auto (origin/HEAD, else HEAD) or a git ref." },
            "scope": { "enum": ["lines", "files", "all"] }
          }
        },
        "implicitCounterparts": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } }
  }
}
