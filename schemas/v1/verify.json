{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/verify.json",
  "title": "offramp verify result",
  "description": "The result of `offramp verify`. See docs/spec/commands/workspace.md#verify.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "status", "passed", "scope", "projects", "errors", "errorCount", "baseline", "baselineRecorded", "invocations", "outputTail"],
  "properties": {
    "mode": { "enum": ["build", "command", "none"] },
    "status": { "enum": ["passed", "failed", "timedOut", "skipped"] },
    "passed": { "type": "boolean" },
    "scope": { "type": "string" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "status", "errors"],
        "properties": {
          "project": { "$ref": "workspace.json#/$defs/relativePath" },
          "status": { "enum": ["passed", "failed", "notVerified"] },
          "errors": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "Errors that count (all without a baseline, the new ones with one), grouped by code; `first` is the first in path order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "count", "first"],
        "properties": {
          "code": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "first": { "$ref": "#/$defs/error" }
        }
      }
    },
    "errorCount": { "type": "integer", "minimum": 0 },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "known", "new", "fixed", "newCodes"],
          "properties": {
            "path": { "$ref": "workspace.json#/$defs/relativePath" },
            "known": { "type": "integer", "minimum": 0 },
            "new": { "type": "integer", "minimum": 0 },
            "fixed": { "type": "integer", "minimum": 0 },
            "newCodes": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "baselineRecorded": { "type": ["string", "null"] },
    "invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandLine", "binlog", "exitCode", "timedOut"],
        "properties": {
          "commandLine": { "type": "string" },
          "binlog": { "type": ["string", "null"] },
          "exitCode": { "type": "integer" },
          "timedOut": { "type": "boolean" }
        }
      }
    },
    "outputTail": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "project", "file", "line", "column"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "project": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"] },
        "column": { "type": ["integer", "null"] }
      }
    }
  }
}
