{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/web-inventory.json",
  "title": "offramp web inventory result",
  "description": "The result of `offramp web inventory`. See docs/spec/commands/scaffold.md#web-inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "kind", "url", "controllers", "routes", "attributeRouting", "globalFilters", "containerFilters", "areas", "modules", "handlers", "globalAsax", "bundles", "webForms", "session", "outputCache", "settings", "systemWeb"],
  "properties": {
    "project": { "$ref": "workspace.json#/$defs/relativePath" },
    "kind": { "type": "string", "pattern": "^(none|(mvc|webapi|webforms)(\\+(mvc|webapi|webforms))*)$", "description": "mvc, webapi, webforms, a combination joined with +, or none." },
    "url": { "type": ["string", "null"], "description": "The application's URL from the project's IIS settings (its host's, for a hosted project)." },
    "hostedBy": { "type": ["string", "null"], "description": "The web project whose application loads this one (ADR 0055), else null." },
    "controllers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "kind", "area", "routePrefix", "filters", "file", "actions"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "description": "The class, fully qualified." },
          "kind": { "enum": ["mvc", "webapi"] },
          "area": { "type": ["string", "null"] },
          "routePrefix": { "type": ["string", "null"] },
          "filters": { "type": "array", "items": { "type": "string" } },
          "file": { "$ref": "workspace.json#/$defs/relativePath" },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "httpMethods", "routes", "filters", "file", "line"],
              "properties": {
                "name": { "type": "string" },
                "httpMethods": { "type": "array", "items": { "type": "string" }, "description": "Empty means any method." },
                "routes": { "type": "array", "items": { "type": "string" }, "description": "Attribute route templates, combined with the controller's prefix." },
                "filters": { "type": "array", "items": { "type": "string" } },
                "file": { "$ref": "workspace.json#/$defs/relativePath" },
                "line": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "description": "Convention routes of the application and the projects it references: MapRoute, MapHttpRoute, an area's MapRoute, IgnoreRoute, RouteCollection.Add, MapODataServiceRoute, also through the codebase's own helpers (ADR 0059). In file and line order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "template", "computed", "kind", "area", "defaults", "helper", "file", "line"],
        "properties": {
          "name": { "type": "string", "description": "Empty when the route has none; (computed) when code computes it at run time." },
          "template": { "type": "string", "description": "(computed) when code computes it at run time." },
          "computed": { "type": ["string", "null"], "description": "For a computed template, the C# that computes it, with a helper's parameters replaced by the call's arguments." },
          "kind": { "enum": ["mvc", "webapi", "odata", "ignore"] },
          "area": { "type": ["string", "null"], "description": "The AreaRegistration's area, DataTokens[\"area\"], or the area default." },
          "defaults": { "type": "array", "items": { "type": "string" }, "description": "name = value in source order; ? marks an optional parameter." },
          "helper": { "type": ["string", "null"], "description": "The codebase's method the registration goes through (Type.Method, or a local function's name)." },
          "file": { "$ref": "workspace.json#/$defs/relativePath" },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "attributeRouting": { "type": "array", "items": { "enum": ["mvc", "webapi"] } },
    "globalFilters": { "type": "array", "items": { "type": "string" } },
    "containerFilters": {
      "type": "array",
      "description": "Filters registered with a dependency injection container (Autofac's As*FilterFor<TController>), in file and line order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filter", "kind", "controller", "action", "file", "line"],
        "properties": {
          "filter": { "type": "string", "description": "The filter class, fully qualified." },
          "kind": { "type": "string", "pattern": "^(action|result|exception|authorization|authentication)( override)?$" },
          "controller": { "type": ["string", "null"], "description": "The controller class or base class it applies to; null for every controller." },
          "action": { "type": ["string", "null"], "description": "The action it applies to; null for every action." },
          "file": { "$ref": "workspace.json#/$defs/relativePath" },
          "line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "areas": { "type": "array", "items": { "type": "string" }, "description": "AreaRegistration classes and the areas routes name, sorted." },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "handlers": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "globalAsax": { "type": "array", "items": { "type": "string" }, "description": "The Global.asax class's Application_* and Session_* handlers." },
    "bundles": { "type": "array", "items": { "type": "string" } },
    "webForms": { "type": "array", "items": { "$ref": "workspace.json#/$defs/relativePath" }, "description": "Pages, user controls, master pages, handlers (.ashx), and services (.asmx)." },
    "session": { "type": "array", "items": { "$ref": "#/$defs/site" } },
    "outputCache": { "type": "array", "items": { "$ref": "#/$defs/site" } },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authentication", "loginUrl", "sessionState", "machineKey", "customErrors", "sections"],
      "properties": {
        "authentication": { "type": ["string", "null"] },
        "loginUrl": { "type": ["string", "null"] },
        "sessionState": { "type": ["string", "null"] },
        "machineKey": { "type": "boolean" },
        "customErrors": { "type": ["string", "null"] },
        "sections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "systemWeb": {
      "type": "array",
      "description": "Per source file, the System.Web.* types it uses.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "types"],
        "properties": {
          "file": { "$ref": "workspace.json#/$defs/relativePath" },
          "types": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "file", "path", "verb", "registeredIn"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "file": { "type": ["string", "null"], "description": "The class's file, or null when it is not in the project." },
        "path": { "type": ["string", "null"] },
        "verb": { "type": ["string", "null"] },
        "registeredIn": { "type": "array", "items": { "enum": ["system.web", "system.webServer"] } }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "what"],
      "properties": {
        "file": { "$ref": "workspace.json#/$defs/relativePath" },
        "line": { "type": "integer", "minimum": 1 },
        "what": { "type": "string" }
      }
    }
  }
}
