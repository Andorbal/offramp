{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/report-data.json",
  "title": "Offramp progress report data",
  "description": "`offramp report --format json`: the numbers behind every rendering of the report. See docs/spec/commands/workspace.md#report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "asOf", "since", "headline", "series", "areas", "applications", "frontier"],
  "properties": {
    "title": { "type": "string" },
    "asOf": { "type": "string", "description": "When the workspace model was built." },
    "since": { "type": ["string", "null"], "description": "The --since bound: yyyy-MM-dd or a UTC time." },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "loc", "frameworkProjects", "frameworkLoc", "portablePercent", "frameworkLocChange", "applications", "applicationsDone", "ready"],
      "properties": {
        "projects": { "type": "integer", "minimum": 0 },
        "loc": { "type": "integer", "minimum": 0 },
        "frameworkProjects": { "type": "integer", "minimum": 0 },
        "frameworkLoc": { "type": "integer", "minimum": 0 },
        "portablePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "frameworkLocChange": { "type": "integer", "description": "Framework-only lines now minus at the first point of the series; negative is progress." },
        "applications": { "type": "integer", "minimum": 0 },
        "applicationsDone": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0, "description": "Framework-only projects that can be ported today." }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "description": "Ledger snapshots in range, oldest first, ending with the current model.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["createdAt", "projects", "loc", "byFrameworkClass", "byKind"],
        "properties": {
          "createdAt": { "type": "string" },
          "projects": { "type": "integer", "minimum": 0 },
          "loc": { "type": "integer", "minimum": 0 },
          "byFrameworkClass": { "$ref": "#/$defs/byFrameworkClass" },
          "byKind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "projects", "loc", "byFrameworkClass"],
        "properties": {
          "area": { "type": "string", "description": "The directory holding project folders; \".\" near the root." },
          "projects": { "type": "integer", "minimum": 0 },
          "loc": { "type": "integer", "minimum": 0 },
          "byFrameworkClass": { "$ref": "#/$defs/byFrameworkClass" }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "name", "kind", "frameworkClass", "status", "closure", "remaining", "remainingLoc", "next"],
        "properties": {
          "project": { "$ref": "workspace.json#/$defs/relativePath" },
          "name": { "type": "string" },
          "kind": { "enum": ["console", "service", "web", "winforms", "wpf"] },
          "frameworkClass": { "$ref": "workspace.json#/$defs/frameworkClass" },
          "status": { "enum": ["done", "ready", "blocked"] },
          "closure": { "type": "integer", "minimum": 1 },
          "remaining": { "type": "integer", "minimum": 0 },
          "remainingLoc": { "type": "integer", "minimum": 0 },
          "next": { "$ref": "workspace.json#/$defs/pathList" }
        }
      }
    },
    "frontier": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "name", "loc", "dependents"],
        "properties": {
          "project": { "$ref": "workspace.json#/$defs/relativePath" },
          "name": { "type": "string" },
          "loc": { "type": "integer", "minimum": 0 },
          "dependents": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "classTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "loc"],
      "properties": { "projects": { "type": "integer", "minimum": 0 }, "loc": { "type": "integer", "minimum": 0 } }
    },
    "byFrameworkClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "standard", "modern", "dual"],
      "properties": {
        "framework": { "$ref": "#/$defs/classTotals" }, "standard": { "$ref": "#/$defs/classTotals" },
        "modern": { "$ref": "#/$defs/classTotals" }, "dual": { "$ref": "#/$defs/classTotals" }
      }
    }
  }
}
