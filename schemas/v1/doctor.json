{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/doctor.json",
  "title": "offramp doctor result",
  "description": "The result of `offramp doctor`. See docs/spec/commands/workspace.md#doctor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "environment",
    "summary",
    "fix"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "message",
          "remedy",
          "codes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "skip"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remedy": {
            "type": [
              "string",
              "null"
            ]
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^OFR[0-9]{4}$"
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdks",
        "selectedSdk",
        "globalJson",
        "git",
        "os",
        "target"
      ],
      "properties": {
        "sdks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selectedSdk": {
          "type": [
            "string",
            "null"
          ]
        },
        "globalJson": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "version",
                "rollForward"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "rollForward": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "repository"
          ],
          "properties": {
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "repository": {
              "type": "boolean"
            }
          }
        },
        "os": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "pattern": "^(net[0-9]+\\.0(-windows)?|netstandard2\\.[01])$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "warn",
        "fail",
        "skip"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "skip": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fix": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "alreadyPresent",
            "applied",
            "diff",
            "projectFiles",
            "packagesConfigFiles"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "alreadyPresent": {
              "type": "boolean"
            },
            "applied": {
              "type": "boolean"
            },
            "diff": {
              "type": [
                "string",
                "null"
              ]
            },
            "projectFiles": {
              "type": "array",
              "description": "The MSBuild files whose Windows-only settings the fix conditions, sorted by path (docs/decisions/0063-condition-windows-only-settings-in-project-files.md).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "guards",
                  "applied",
                  "diff"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Repository-relative path."
                  },
                  "guards": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "line",
                        "setting",
                        "step",
                        "condition"
                      ],
                      "properties": {
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "setting": {
                          "type": "string",
                          "description": "The property, or `Exec in target X`."
                        },
                        "step": {
                          "enum": [
                            "sgen",
                            "aspnet-compiler",
                            "build-event",
                            "nuget-restore",
                            "msbuild-extensions-path"
                          ]
                        },
                        "condition": {
                          "type": "string",
                          "description": "The condition added: '$(MSBuildRuntimeType)' != 'Core' or '$(OS)' == 'Windows_NT'."
                        }
                      }
                    }
                  },
                  "applied": {
                    "type": "boolean"
                  },
                  "diff": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "packagesConfigFiles": {
              "type": "array",
              "description": "With packages.config projects, the files that let dotnet restore restore them (Offramp.PackagesConfig.targets, Directory.Solution.targets), when they are missing or out of date (docs/decisions/0064-dotnet-build-and-packages-config-without-offramp.md).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "applied",
                  "diff"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "applied": {
                    "type": "boolean"
                  },
                  "diff": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "description": "The compile-only fix with --fix; null otherwise."
    }
  }
}
