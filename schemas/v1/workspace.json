{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offramp.dev/schemas/v1/workspace.json",
  "title": "Offramp workspace model",
  "description": ".offramp/workspace.json, written by `offramp scan`. See docs/spec/02-workspace-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "createdAt", "repositoryRoot", "solution", "source", "sdk", "projects", "graph", "packages", "inputs", "diagnostics"],
  "properties": {
    "$schema": { "const": "https://offramp.dev/schemas/v1/workspace.json" },
    "version": { "const": 1 },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "repositoryRoot": { "type": "string" },
    "solution": { "type": ["string", "null"] },
    "source": { "$ref": "#/$defs/source" },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "os"],
      "properties": { "version": { "type": "string" }, "os": { "type": "string" } }
    },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "graph": { "$ref": "#/$defs/graph" },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["versions"],
        "properties": {
          "versions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/pathList" } }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": { "path": { "$ref": "#/$defs/relativePath" }, "sha256": { "$ref": "#/$defs/sha256" } }
      }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "envelope.json#/$defs/diagnostic" } }
  },
  "$defs": {
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)[^\\\\]*$" },
    "pathList": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "complog"],
      "properties": {
        "kind": { "enum": ["binlog", "complog", "build"] },
        "path": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "complog": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" } }
            }
          ]
        }
      }
    },
    "kind": { "enum": ["test", "web", "winforms", "wpf", "service", "console", "library", "unknown"] },
    "frameworkClass": { "enum": ["framework", "standard", "modern", "dual"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "assemblyName", "rootNamespace", "language", "kind", "kindEvidence", "sdkStyle", "sdk", "targetFrameworks",
        "frameworkClass", "outputType", "isTestProject", "properties", "defineConstants", "windowsOnlyBuildSteps", "packagesConfig",
        "compile", "compileExplicit", "projectReferences", "packageReferences", "assemblyReferences", "comReferences",
        "internalsVisibleTo", "resolved", "compilerCalls", "loc", "config"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/relativePath" },
        "name": { "type": "string" },
        "assemblyName": { "type": ["string", "null"] },
        "rootNamespace": { "type": ["string", "null"] },
        "language": { "enum": ["csharp", "vb", "fsharp", "other"] },
        "kind": { "$ref": "#/$defs/kind" },
        "kindEvidence": { "type": ["string", "null"] },
        "sdkStyle": { "type": "boolean" },
        "sdk": { "type": ["string", "null"] },
        "targetFrameworks": { "type": "array", "items": { "type": "string" } },
        "frameworkClass": { "$ref": "#/$defs/frameworkClass" },
        "outputType": { "type": ["string", "null"] },
        "isTestProject": { "type": "boolean" },
        "properties": { "type": "object", "additionalProperties": { "type": "string" } },
        "defineConstants": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "windowsOnlyBuildSteps": {
          "type": "array",
          "items": { "enum": ["sgen", "com", "entity-deploy", "t4", "fakes", "ssdt", "build-event"] }
        },
        "packagesConfig": { "type": "boolean" },
        "compile": { "$ref": "#/$defs/pathList" },
        "compileExplicit": { "type": "boolean" },
        "projectReferences": { "$ref": "#/$defs/pathList" },
        "packageReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "versionOverride", "privateAssets", "tfms"],
            "properties": {
              "id": { "type": "string" },
              "version": { "type": ["string", "null"] },
              "versionOverride": { "type": ["string", "null"] },
              "privateAssets": { "type": ["string", "null"] },
              "tfms": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "assemblyReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "hintPath", "kind", "metadata"],
            "properties": {
              "name": { "type": "string" },
              "hintPath": { "type": ["string", "null"] },
              "kind": { "enum": ["framework", "file"] },
              "metadata": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["assemblyVersion", "targetFramework", "publicKeyToken"],
                    "properties": {
                      "assemblyVersion": { "type": ["string", "null"] },
                      "targetFramework": { "type": ["string", "null"] },
                      "publicKeyToken": { "type": ["string", "null"] }
                    }
                  }
                ]
              }
            }
          }
        },
        "comReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "guid", "embedInteropTypes"],
            "properties": {
              "name": { "type": "string" },
              "guid": { "type": ["string", "null"] },
              "embedInteropTypes": { "type": "boolean" }
            }
          }
        },
        "internalsVisibleTo": { "type": "array", "items": { "type": "string" } },
        "resolved": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packages"],
            "properties": {
              "packages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "version", "dependencies", "direct"],
                  "properties": {
                    "id": { "type": "string" },
                    "version": { "type": "string" },
                    "direct": { "type": "boolean" },
                    "dependencies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "range"],
                        "properties": { "id": { "type": "string" }, "range": { "type": "string" } }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "compilerCalls": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["complog", "index"],
            "properties": { "complog": { "$ref": "#/$defs/relativePath" }, "index": { "type": "integer", "minimum": 0 } }
          }
        },
        "loc": { "type": "integer", "minimum": 0 },
        "partial": { "const": true, "description": "Present only when some target frameworks have no compiler call." },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kindOverride", "excluded"],
          "properties": {
            "kindOverride": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/kind" }] },
            "excluded": { "type": "boolean" },
            "frozen": { "const": true }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "cycles", "topologicalOrder"],
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "kind"],
            "properties": {
              "from": { "$ref": "#/$defs/relativePath" },
              "to": { "$ref": "#/$defs/relativePath" },
              "kind": { "enum": ["project", "assembly"] }
            }
          }
        },
        "cycles": { "type": "array", "items": { "$ref": "#/$defs/pathList" } },
        "topologicalOrder": { "$ref": "#/$defs/pathList" }
      }
    }
  }
}
